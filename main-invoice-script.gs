  Logger.log('🧪 Testing duplicate detection...');

  const testData = {
    supplier_category: 'priority',
    supplier_name: 'מקאנו',
    document_number: 'DUP-TEST-999',
    document_type: 'invoice',
    document_date: '04/01/2026',
